# -------------------------------------------------------
# .env.example — Lokal test için .env dosyası şablonu
# Kullanım: Bu dosyayı kopyalayıp ".env" olarak kaydet,
# gerçek değerleri doldur. .env dosyasını ASLA commit etme!
# -------------------------------------------------------

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail hesabı (gönderi yapacak hesap)
GMAIL_USER=your_gmail_address@gmail.com

# Gmail App Password — NOT: Normal şifren değil!
# Oluşturmak için: Gmail → Ayarlar → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
# Boşlukları kaldır, 16 karakter olmalı
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Alıcı listesi (JSON array)
# Her alıcı: name (ad), email (mail), city (cities.yaml'daki şehir adı), language (tr/en)
RECIPIENTS=[{"name":"Batuhan","email":"sen@gmail.com","city":"Riga","language":"tr"}]

# Birden fazla alıcı örneği:
# RECIPIENTS=[{"name":"Batuhan","email":"sen@gmail.com","city":"Riga","language":"tr"},{"name":"Ahmet","email":"ahmet@gmail.com","city":"Istanbul","language":"tr"}]
