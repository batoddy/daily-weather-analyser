{
  "name": "daily-weather-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "bot:local": "node scripts/local-bot.mjs",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply weather-bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply weather-bot --remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
